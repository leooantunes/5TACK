# Copie para .env e preencha. NUNCA versione o .env.
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

# Origens permitidas no CORS (separadas por vírgula). O app nativo não usa CORS; isto vale para web/admin.
CORS_ORIGINS=http://localhost:8081

# Fonte de dados: "mock" (desenvolvimento) ou "pandascore"
DATA_PROVIDER=mock
# Chave da PandaScore — fica SÓ no servidor, nunca no app.
PANDASCORE_TOKEN=
